# HINWEIS: Diese .pkla-Regel (polkit 0.105, localauthority) kann NICHT auf eine einzelne Einheit/Unit eingeschraenkt werden.
# Sie gibt dem Benutzer overlord alle systemd-Einheiten frei ueber org.freedesktop.systemd1.manage-units.
# Siehe deploy/README.md, Abschnitt "Berechtigung fuer den Dienstneustart".
[kap2-test: overlord darf systemd-Einheiten ueber D-Bus verwalten]
Identity=unix-user:overlord
Action=org.freedesktop.systemd1.manage-units
ResultAny=yes
ResultInactive=yes
ResultActive=yes
