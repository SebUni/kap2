# T-0195: als systemd-USER-Unit fuer "overlord" installiert (~/.config/systemd/user/kap2-test.service),
# nicht mehr als System-Unit unter /etc/systemd/system. Ein Neustart per System-Unit braucht
# root-Rechte, die der nicht-interaktive Deploy-Lauf nur ueber sudo oder eine Polkit-Regel
# bekommen koennte; sudo scheitert dort zuverlaessig an der "no new privileges"-Sperre des
# aufrufenden Prozesses (das Deploy-Skript kann diese Sperre nicht aufheben), und eine fehlende
# oder unvollstaendige Polkit-Regel liegt ausserhalb dieses Repos. Als User-Unit verwaltet
# "overlord" den Dienst ueber seine eigene systemd-Instanz (systemctl --user) -- das braucht
# keinerlei Rechteausweitung. Einmalig auf dem Server noetig: "loginctl enable-linger overlord",
# damit die User-Instanz auch ohne aktive Anmeldesitzung laeuft (siehe deploy/README.md).
# "After=postgresql.service" entfaellt: eine User-Unit kann nicht gegen eine System-Unit ordnen
# (kein gemeinsamer Bus/keine gemeinsame Transaktion); Restart=on-failure faengt einen zu fruehen
# Start bereits ab, da Postgres auf diesem Server durchgehend laeuft.
[Unit]
Description=KAP2 Testumgebung (uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/overlord/kap2/backend
EnvironmentFile=/etc/overlord/kap2-test.env
ExecStart=/opt/overlord/kap2-venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=default.target
