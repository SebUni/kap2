# System-Unit nach /etc/systemd/system/kap2-test.service.
# T-0195: Der Neustart aus dem Deploy-Lauf braucht keine Rechteausweitung per sudo mehr
# (sudo scheitert dort an der "no new privileges"-Sperre des aufrufenden Prozesses und laesst
# sich per sudoers nicht reparieren), sondern laeuft ueber die Polkit-Regel
# deploy/polkit-kap2-test.rules: "systemctl restart kap2-test" spricht per D-Bus mit PID 1,
# und PID 1 fragt Polkit -- das ist von NoNewPrivileges nicht betroffen, weil kein setuid-Programm
# ausgefuehrt wird. Deshalb bleibt dies bewusst eine System-Unit: sie startet beim Boot ohne
# "loginctl enable-linger", kann gegen postgresql.service ordnen und behaelt User=/Group=overlord.
# User=/Group= sind zwingend: ohne sie liefe uvicorn hier als root.
[Unit]
Description=KAP2 Testumgebung (uvicorn)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=overlord
Group=overlord
WorkingDirectory=/opt/overlord/kap2/backend
EnvironmentFile=/etc/overlord/kap2-test.env
ExecStart=/opt/overlord/kap2-venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
